# Site configuration
NEXT_PUBLIC_SITE_URL=https://www.aiaengineering.com
NEXT_PUBLIC_SITE_ENV=development # "production" | "staging" | "development"
NEXT_PUBLIC_MEDIA_URL=https://media.aiaengineering.com # or "/media" locally
NEXT_PUBLIC_HOME_ONLY=true # lock is ON unless this is "false"

# Contact form handling
CONTACT_WEBHOOK_URL=
CONTACT_ROUTE_MINING=mining-enquiries@aiaengineering.com
CONTACT_ROUTE_CEMENT=cement-enquiries@aiaengineering.com
CONTACT_ROUTE_QUARRY=quarry-enquiries@aiaengineering.com
CONTACT_ROUTE_THERMAL_POWER=power-enquiries@aiaengineering.com
CONTACT_ROUTE_INVESTOR_RELATIONS=investor-relations@aiaengineering.com
CONTACT_ROUTE_CAREERS=careers@aiaengineering.com
CONTACT_ROUTE_GENERAL=info@aiaengineering.com

# ISR and CMS
REVALIDATE_SECRET=
CMS_PROVIDER=local # "local" | "contentful" | "sanity"
DRAFT_SECRET= # CMS preview token for /api/draft (staging only)

# Production refuses to start unless NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_MEDIA_URL,
# CONTACT_WEBHOOK_URL and REVALIDATE_SECRET (32+ chars) are set. See src/lib/env.server.ts.
